# Public URL, no trailing slash
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://partyfinder:change-me@db:5432/partyfinder
POSTGRES_DB=partyfinder
POSTGRES_USER=partyfinder
POSTGRES_PASSWORD=change-me

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Optional: require a specific guild role. Leave empty to allow all guild members.
DISCORD_REQUIRED_ROLE_ID=

# 32+ random bytes, e.g. `openssl rand -hex 32`
APP_SECRET=

# Production only. Set true behind HTTPS.
SECURE_COOKIES=false
