# Migu's Partyfinder - PRODUCTION ENVIRONMENT TEMPLATE
#
# Copy this file to:
#
#   .env
#
# on the production server and replace every placeholder.
#
# NEVER commit the real .env.

# Public HTTPS origin. No trailing slash.
APP_URL=https://partyfinder.example.com

# PostgreSQL
#
# Generate a strong value with:
#   openssl rand -hex 32
#
# Use the SAME password in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_DB=partyfinder
POSTGRES_USER=partyfinder
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHAR_PASSWORD
DATABASE_URL=postgresql://partyfinder:REPLACE_WITH_RANDOM_64_HEX_CHAR_PASSWORD@db:5432/partyfinder

# Discord OAuth application
DISCORD_CLIENT_ID=REPLACE_ME
DISCORD_CLIENT_SECRET=REPLACE_ME
DISCORD_GUILD_ID=REPLACE_ME

# Optional. Leave empty if every member of the guild may use Partyfinder.
DISCORD_REQUIRED_ROLE_ID=

# Generate independently from the PostgreSQL password:
#   openssl rand -hex 32
APP_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_HEX_CHAR_SECRET

# Required for production HTTPS.
SECURE_COOKIES=true
