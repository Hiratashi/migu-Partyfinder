# Public URL, no trailing slash
# Local:
APP_URL=http://localhost:3000

# Production example:
# APP_URL=https://partyfinder.example.com

# PostgreSQL
# Generate a strong password, for example:
#   openssl rand -hex 32
DATABASE_URL=postgresql://partyfinder:change-me@db:5432/partyfinder
POSTGRES_DB=partyfinder
POSTGRES_USER=partyfinder
POSTGRES_PASSWORD=change-me

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Optional: require a specific guild role. Leave empty to allow all guild members.
DISCORD_REQUIRED_ROLE_ID=

# 32+ random bytes, e.g.:
#   openssl rand -hex 32
APP_SECRET=

# Local development can remain false.
# Production behind HTTPS must be true.
SECURE_COOKIES=false
